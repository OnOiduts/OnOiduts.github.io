---
/**
 * 全站覆盖层：加载态（屏幕中央显示 B，呼吸）、阅读进度条、返回顶部、图片灯箱。
 * 进度条与返回顶部只在文章页 / 项目详情页启用（由 withProgress 控制）。
 */
import SvgB from './SvgB.astro';

interface Props {
  withProgress?: boolean;
}
const { withProgress = false } = Astro.props;
---

<div id="boot">
  <div class="boot-logo" style="width: 300px; height: 300px;">
    <SvgB interactive={false} />
  </div>
</div>

{withProgress && <div class="progress" id="progress"></div>}

<button class="to-top" id="to-top" type="button" aria-label="返回顶部">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7" />
  </svg>
</button>

<div class="lightbox" id="lightbox"><img alt="" /></div>

<!-- 世界转场偏色层：切换瞬间整屏偏成目标世界的强调色，再快速褪回。
     放在 #app 之外（root 层叠上下文里），这样 mix-blend-mode 能染到网格。 -->
<div id="world-tint" aria-hidden="true"></div>

<style>
  /* ⚠️ 本轮：世界转场加「整体偏色」。
     用 mix-blend-mode: color —— 只替换色相/饱和度、保留明度，
     所以画面不会变亮或变暗，只是**整屏偏成该世界的颜色**，正是「偏色」而非「盖一层色膜」。

     ⚠️ 不能用 opacity 以外的 transform / filter：那些会创建包含块，
        虽然这一层没有 fixed 后代，但 filter 还会强制整屏重绘，代价更大。

     ⚠️ 背景直接取 var(--accent)：这一层是在**世界已经切完**之后才加 .on 的，
        所以 --accent 已经是目标世界的颜色，不需要额外传参。 */
  #world-tint {
    position: fixed;
    inset: 0;
    z-index: 90;
    pointer-events: none;
    opacity: 0;
    background: var(--accent);
    mix-blend-mode: color;
  }

  #world-tint.on {
    animation: world-tint 520ms cubic-bezier(0.3, 0.9, 0.4, 1) both;
  }

  /* 0% 起手 → 18% 达到最浓（约 94ms，正好压在切色点附近）→ 100% 褪回透明。
     整体比转场（600ms）略短，保证「短暂偏移然后恢复」，不拖尾。 */
  @keyframes world-tint {
    0% { opacity: 0; }
    18% { opacity: 0.9; }
    46% { opacity: 0.5; }
    100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    #world-tint.on { animation: none; }
  }
</style>
